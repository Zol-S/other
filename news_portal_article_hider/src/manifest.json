{
  "manifest_version": 3,
  "name": "News Portal Article Disabler",
  "version": "1.2.0",
  "description": "Hides articles on news portals based on blocked keywords. Click the icon to add new keyword to be blocked.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://index.hu/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://index.hu/*"
      ],
      "js": ["content.js"],
      "css": ["styles/content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Toggle learning mode",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["blocked_keywords.yaml", "config.yaml"],
      "matches": ["https://index.hu/*"]
    }
  ]
}
